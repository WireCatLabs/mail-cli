      "json": {
        "item": {
          "saved": 1,
          "complete": true
        }
      }
    },
    {
      "id": "previous-search",
      "args": ["gm", "search", "messages", "wirecat-synthetic-mail-canary", "--offline", "--json"],
      "exit": 0,
      "stream": "stdout",
      "kind": "json",
      "previous": true,
      "allowSensitiveOutput": true,
      "capture": {
        "ref": "/items/0/ref"
      }
    },
    {
      "id": "candidate-status",
      "args": ["gm", "status", "--json"],
