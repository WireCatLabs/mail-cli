    "entry": "./previous/node_modules/@wirecat/previous-cli/dist/bin/mail.js",
    "version": "0.16.3"
  },
  "fixtures": [
    {
      "path": "takeout.mbox",
      "text": "From 1700000000000000001@xxx Mon Jul 24 10:00:00 +0000 2023\nX-GM-THRID: 1700000000000000001\nX-Gmail-Labels: Inbox,Opened\nMessage-ID: <upgrade-1@example.com>\nFrom: Ann Example <ann@example.com>\nTo: owner@gmail.com\nSubject: Synthetic upgrade note\nDate: Mon, 24 Jul 2023 10:00:00 +0000\n\nwirecat-synthetic-mail-canary\n\n"
