{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "dev.wirecat/mail-cli",
  "title": "WireCat Mail",
  "description": "Your mailbox for agents: search, organise, draft and send mail. Add the account with mail first.",
  "websiteUrl": "https://github.com/WireCatLabs/mail-cli#readme",
  "repository": {
    "url": "https://github.com/WireCatLabs/mail-cli",
    "source": "github"
  },
  "version": "0.1.1",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@wirecat/mail-cli",
      "version": "0.1.1",
      "runtimeHint": "npx",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        },
        {
          "type": "positional",
          "value": "serve"
        },
        {
          "type": "named",
          "name": "--profiles",
          "value": "all"
        }
      ]
    }
  ]
}
