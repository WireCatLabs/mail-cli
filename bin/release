#!/usr/bin/env sh
# Publishes the version in package.json and tags it. Run on a clean `main` that matches origin/main; the owner runs
# it, never an agent. When npm already has that version, or a higher one, it raises it to the next free one through a
# pull request and publishes that (WC-REL-5). Nothing is published until `pnpm release:check` passes.
#
#   bin/release           # publishes from GitHub Actions (.github/workflows/release.yml, npm trusted publishing)
#   bin/release --local   # publishes from this computer: NPM_TOKEN if exported, else the keyring, else `npm login`
#
# The keyring is read only when NPM_KEYRING_ACCOUNT names the account the token is stored under
# (`secret-tool store --label=npm service npm account <account>`); unset, the keyring is skipped. Set, a failed
# lookup stops the release instead of falling back to `npm login`.
#
# A package that is not on npm yet is published the same way; its first version needs --local until npm trusts
# release.yml. The npm token is never printed and never written to a file (WC-REL-14).
set -eu

# Keep the caller's token out of the checks and of every lifecycle script.
publish_token=${NPM_TOKEN:-}
unset NPM_TOKEN

mode=ci
for arg; do
  case "$arg" in
    --local) mode=local ;;
    *) echo "usage: bin/release [--local]" >&2; exit 2 ;;
  esac
done

cd "$(dirname "$0")/.."
self=$(git hash-object bin/release)
# The fold and land() fast-forward main, and sh reads this file as it goes: a newer bin/release would run half old,
# half new.
rerun_if_changed() {
  [ "$(git hash-object bin/release)" != "$self" ] || return 0
  [ -z "${WIRECAT_RELEASE_RERUN:-}" ] || { echo "bin/release changed again while releasing — run it again" >&2; exit 1; }
  echo "bin/release changed on main — running the new one"
  export WIRECAT_RELEASE_RERUN=1
  NPM_TOKEN="$publish_token" exec ./bin/release "$@"
}

git fetch -q --tags origin
[ "$(git branch --show-current)" = main ] || { echo "run from main" >&2; exit 1; }
[ -z "$(git status --porcelain --untracked-files=no)" ] || { echo "uncommitted changes" >&2; exit 1; }
[ "$(git rev-parse HEAD)" = "$(git rev-parse origin/main)" ] || { echo "update main to origin/main first" >&2; exit 1; }
# One release at a time per package on this machine (WC-REL-3).
. ./config/wirecat/release-lock.sh
wirecat_release_lock "${WIRECAT_RELEASE_WAIT_SECONDS:-0}"
git fetch -q origin
[ "$(git rev-parse HEAD)" = "$(git rev-parse origin/main)" ] || { echo "main changed while waiting; update main first" >&2; exit 1; }

pnpm install --frozen-lockfile
package=$(node -p 'require("./package.json").name')
version=$(node -p 'require("./package.json").version')
# A 404 for a package npm has never seen is "not published", like any other failure of `npm view`.
published() {
  npm view "$package@$version" version --prefer-online >/dev/null 2>&1
}
# The version list `npm view` reads can lag minutes behind a publish.
wait_for_npm() {
  echo "== waiting for npm to show $version (up to fifteen minutes) =="
  for _ in $(seq 90); do
    published && return 0
    sleep 10
  done
  return 1
}

# main takes changes only through a pull request (the repository's ruleset).
land() {
  branch=$1 title=$2 body=$3
  git switch -q -c "$branch"
  git commit -q -am "$title" -m "$body"
  git push -q -u origin "$branch"
  git switch -q main
  pr=$(gh pr create --base main --head "$branch" --title "$title" --body "$body")
  # Checks register a few seconds after the pull request; --watch with none exits at once.
  for _ in $(seq 30); do
    [ "$(gh pr checks "$pr" --json name --jq length 2>/dev/null || echo 0)" -gt 0 ] && break
    sleep 2
  done
  gh pr checks "$pr" --watch --fail-fast >/dev/null ||
    { echo "checks failed on $pr — nothing is published" >&2; exit 1; }
  git fetch -q origin
  [ "$(git rev-parse HEAD)" = "$(git rev-parse origin/main)" ] ||
    { echo "main advanced while $pr was being prepared — stop and review the current version before merging" >&2; exit 1; }
  gh pr merge "$pr" --squash --delete-branch --subject "$title (#${pr##*/})"
  git fetch -q origin
  git merge -q --ff-only origin/main
  [ "$(git rev-parse HEAD)" = "$(git rev-parse origin/main)" ] ||
    { echo "main is not origin/main after $pr" >&2; exit 1; }
}

# A pull request checked before the last release and merged after it put its entry in that release's section;
# restore moves it to Unreleased, so the fold below brings it into this version.
restored=$(pnpm exec cli-dev changelog restore --land)
[ -z "$restored" ] || echo "$restored"
rerun_if_changed "$@"

# A merge after the version was dated, but before it was published, adds Unreleased above it; --land folds it on a
# fresh main through its own pull request.
folded=""
published || folded=$(pnpm exec cli-dev changelog fold --land --version "$version")
[ -z "$folded" ] || echo "$folded"
rerun_if_changed "$@"

# Two sessions preparing the same number is normal; the second takes the next free one.
latest=$(npm view "$package" version --prefer-online 2>/dev/null || true)
versions=$(npm view "$package" versions --json --prefer-online 2>/dev/null || true)
next=$(pnpm exec cli-dev next-version "$version" "$latest" "$versions")
if [ "$next" != "$version" ]; then
  taken=""
  if published; then taken=1; why="$version is already on npm"; else why="$version is not above npm's latest $latest"; fi
  echo "$why — publishing $next instead"
  # A version npm already has keeps its changelog section; the unreleased one becomes the new version.
  node -e 'const fs = require("fs"); const [o, n, taken] = process.argv.slice(1)
    const swap = (file, from, to) => {
      const text = fs.readFileSync(file, "utf8")
      if (!text.includes(from)) throw new Error(`${file} has no ${JSON.stringify(from.trim())} to raise ${o} to ${n}`)
      fs.writeFileSync(file, text.replace(from, to))
    }
    swap("package.json", `"version": "${o}"`, `"version": "${n}"`)
    swap("src/version.ts", `VERSION = "${o}"`, `VERSION = "${n}"`)
    const today = new Date().toLocaleDateString("en-GB").replaceAll("/", ".")
    if (taken) swap("CHANGELOG.md", "\n## Unreleased\n", `\n## ${n} — ${today}\n`)
    else swap("CHANGELOG.md", `\n## ${o} — `, `\n## ${n} — `)' "$version" "$next" "$taken"
  body="bin/release: $why. Only the number changes: package.json, src/version.ts, the CHANGELOG heading."
  land "release/$next" "chore(release): $next" "$body"
  rerun_if_changed "$@"
  version=$next
fi
top=$(sed -n '/^## /{p;q;}' CHANGELOG.md)
case "$top" in
  "## $version — "[0-9][0-9].[0-9][0-9].[0-9][0-9][0-9][0-9]) ;;
  *) echo "date the top changelog section as \"## $version — DD.MM.YYYY\" in a pull request before releasing" >&2; exit 1 ;;
esac
if published; then
  echo "$package@$version is already on npm — raise the version first" >&2
  exit 1
fi

echo "== checks for $version =="
pnpm release:check

if [ "$mode" = ci ]; then
  last_run() {
    gh run list --workflow release.yml --branch main --event workflow_dispatch --limit 1 \
      --json databaseId --jq '.[0].databaseId // ""'
  }
  previous=$(last_run)
  gh workflow run release.yml --ref main -f commit="$(git rev-parse HEAD)"
  run=""
  for _ in $(seq 30); do
    run=$(last_run)
    [ -n "$run" ] && [ "$run" != "$previous" ] && break
    run=""
    sleep 2
  done
  [ -n "$run" ] || { echo "the release workflow did not start within a minute — see gh run list --workflow release.yml" >&2; exit 1; }
  # gh run watch also exits non-zero when one of its own API calls fails, while the run goes on: only the run's
  # conclusion and npm say whether the release failed.
  state=""
  for _ in $(seq 30); do
    gh run watch "$run" || sleep 10
    state=$(gh run view "$run" --json status,conclusion --jq '.status + ":" + .conclusion' 2>/dev/null || true)
    case "$state" in completed:*) break ;; esac
  done
  case "$state" in
    completed:success)
      wait_for_npm ||
        { echo "release run $run passed but npm does not show $version — see gh run view $run" >&2; exit 1; } ;;
    completed:*)
      if published; then
        echo "$package@$version is on npm, but release run $run did not pass; check its tag: gh run view $run" >&2
        exit 1
      fi
      echo "release failed; inspect: gh run view $run --log-failed" >&2
      # npm answers 404 to a publish from a workflow it does not trust.
      if gh run view "$run" --log-failed 2>/dev/null | grep -q "404 Not Found - PUT"; then
        echo "npm refused the publish; a package npm does not trust yet publishes its first version with" >&2
        echo "bin/release --local" >&2
      fi
      exit 1 ;;
    *) echo "lost track of release run $run — see gh run view $run" >&2; exit 1 ;;
  esac
  git fetch -q --tags origin
  echo "published $package@$version"
  exit 0
fi

# No default account: this file is copied into every CLI, and one person's account name does not belong in it.
# Without NPM_TOKEN or the entry, npm reads your own login from ~/.npmrc as usual.
keyring_account=${NPM_KEYRING_ACCOUNT:-}
if [ -z "$publish_token" ] && [ -n "$keyring_account" ]; then
  publish_token=$(secret-tool lookup service npm account "$keyring_account" 2>/dev/null) && [ -n "$publish_token" ] ||
    { echo "no npm token in the keyring for service npm, account $keyring_account" >&2; exit 1; }
fi

# Our own npm config names the variable, not the value, so the token stays in the publish process's environment.
config=$(mktemp)
trap 'rm -f "$config"' EXIT
if [ -n "$publish_token" ]; then
  # shellcheck disable=SC2016 # npm resolves the variable only in the publish process.
  printf '//registry.npmjs.org/:_authToken=${NPM_TOKEN}\n' > "$config"
  set -- --userconfig "$config"
else
  npm whoami >/dev/null 2>&1 || {
    echo "no npm token: export NPM_TOKEN; or store one with" >&2
    echo "  secret-tool store --label=npm service npm account <account>" >&2
    echo "and export NPM_KEYRING_ACCOUNT=<account>; or run npm login" >&2
    exit 1
  }
  set --
fi

echo "== local validation for $version =="
pnpm contracts:check
pnpm security:no-leak
pnpm smoke
command -v gitleaks >/dev/null 2>&1 || { echo "gitleaks is not installed; it scans the history before publishing" >&2; exit 1; }
gitleaks git --log-opts=HEAD --no-banner --redact --exit-code 1 .
pnpm audit --prod --audit-level high

echo "== publishing $package@$version =="
pnpm build
NPM_TOKEN="$publish_token" npm publish --access public --ignore-scripts "$@"

wait_for_npm || {
  echo "npm does not show $version after fifteen minutes — not tagging. Once it does, on $(git rev-parse HEAD):" >&2
  echo "  git tag -a v$version -m $version && git push origin v$version" >&2
  exit 1
}

# The same tag and GitHub release that release.yml's tag job makes (WC-REL-13).
git tag -a "v$version" -m "$version"
git push -q origin "v$version"
awk -v v="$version" '$0 ~ "^## "v" " {on=1; next} /^## / && on {exit} on' CHANGELOG.md |
  gh release create "v$version" --title "$version" --notes-file -
echo "published $package@$version"
